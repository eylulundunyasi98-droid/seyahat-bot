{
  "name": "seyahat-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Global Travel Deals Bot - Telegram + Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute travel_db --local --file=./migrations/0001_initial_schema.sql",
    "db:remote": "wrangler d1 execute travel_db --remote --file=./migrations/0001_initial_schema.sql",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "grammy": "^1.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.72.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}